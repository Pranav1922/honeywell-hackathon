!-   =========== EcoLoop additions ===========

! --- the agent's four actuation points ---

  Schedule:Constant, HEATING_SETPOINT_SCH, Temperature, 21.0;
  Schedule:Constant, COOLING_SETPOINT_SCH, Temperature, 24.0;
  Schedule:Constant, LIGHTING_SCH, Fraction, 1.0;
  Schedule:Constant, VENTILATION_SCH, Any Number, 2.0;

! Dual set-point control, held constant at type 4.
  Schedule:Constant, CONTROL_TYPE_SCH, Control Type, 4;

  Schedule:Constant, ACTIVITY_SCH, Any Number, 120.0;
  Schedule:Constant, CO2_OUTDOOR_SCH, Any Number, 420.0;

! --- occupancy: part of the scenario, not of the control surface ---

  Schedule:Compact,
    OCCUPANCY_SCH,           !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: Weekdays,           !- Field 2
    Until: 08:00,0.0,        !- Field 3
    Until: 09:00,0.5,        !- Field 5
    Until: 17:00,1.0,        !- Field 7
    Until: 18:00,0.5,        !- Field 9
    Until: 24:00,0.0,        !- Field 11
    For: AllOtherDays,       !- Field 13
    Until: 24:00,0.0;        !- Field 14

  People,
    Zone One People,         !- Name
    ZONE ONE,                !- Zone or ZoneList or Space or SpaceList Name
    OCCUPANCY_SCH,           !- Number of People Schedule Name
    People,                  !- Number of People Calculation Method
    20,                      !- Number of People
    ,                        !- People per Floor Area {person/m2}
    ,                        !- Floor Area per Person {m2/person}
    0.3,                     !- Fraction Radiant
    ,                        !- Sensible Heat Fraction
    ACTIVITY_SCH,            !- Activity Level Schedule Name
    3.82E-8;                 !- Carbon Dioxide Generation Rate {m3/s-W}

  Lights,
    Zone One Lights,         !- Name
    ZONE ONE,                !- Zone or ZoneList or Space or SpaceList Name
    LIGHTING_SCH,            !- Schedule Name
    LightingLevel,           !- Design Level Calculation Method
    2000.0,                  !- Lighting Level {W}
    ,                        !- Watts per Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    0.0,                     !- Return Air Fraction
    0.2,                     !- Fraction Radiant
    0.6;                     !- Fraction Visible

  ElectricEquipment,
    Zone One Equipment,      !- Name
    ZONE ONE,                !- Zone or ZoneList or Space or SpaceList Name
    OCCUPANCY_SCH,           !- Schedule Name
    EquipmentLevel,          !- Design Level Calculation Method
    1500.0,                  !- Design Level {W}
    ,                        !- Watts per Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    0.0,                     !- Fraction Latent
    0.3,                     !- Fraction Radiant
    0.0;                     !- Fraction Lost

! --- ventilation: air change rate is actuated ---

  ZoneVentilation:DesignFlowRate,
    Zone One Ventilation,    !- Name
    ZONE ONE,                !- Zone or ZoneList or Space or SpaceList Name
    VENTILATION_SCH,         !- Schedule Name
    AirChanges/Hour,         !- Design Flow Rate Calculation Method
    ,                        !- Design Flow Rate {m3/s}
    ,                        !- Flow Rate per Floor Area {m3/s-m2}
    ,                        !- Flow Rate per Person {m3/s-person}
    1.0,                     !- Air Changes per Hour {1/hr}
    Intake,                  !- Ventilation Type
    100.0,                   !- Fan Pressure Rise {Pa}
    0.7,                     !- Fan Total Efficiency
    1.0,                     !- Constant Term Coefficient
    0.0,                     !- Temperature Term Coefficient
    0.0,                     !- Velocity Term Coefficient
    0.0;                     !- Velocity Squared Term Coefficient

  ZoneInfiltration:DesignFlowRate,
    Zone One Infiltration,   !- Name
    ZONE ONE,                !- Zone or ZoneList or Space or SpaceList Name
    ON,                      !- Schedule Name
    AirChanges/Hour,         !- Design Flow Rate Calculation Method
    ,                        !- Design Flow Rate {m3/s}
    ,                        !- Flow Rate per Floor Area {m3/s-m2}
    ,                        !- Flow Rate per Exterior Surface Area {m3/s-m2}
    0.2,                     !- Air Changes per Hour {1/hr}
    1.0,                     !- Constant Term Coefficient
    0.0,                     !- Temperature Term Coefficient
    0.0,                     !- Velocity Term Coefficient
    0.0;                     !- Velocity Squared Term Coefficient

! --- CO2 balance, feeding the IAQ sensor the agent ventilates against ---

  ZoneAirContaminantBalance,
    Yes,                     !- Carbon Dioxide Concentration
    CO2_OUTDOOR_SCH;         !- Outdoor Carbon Dioxide Schedule Name

! --- the sensors sim/energyplus.py reads through api.exchange ---

  Output:Variable,ZONE ONE,Zone People Occupant Count,timestep;
  Output:Variable,ZONE ONE,Zone Air CO2 Concentration,timestep;
  Output:Variable,ZONE ONE,Zone Air Relative Humidity,timestep;
  Output:Variable,Whole Building,Facility Total Electricity Demand Rate,timestep;
