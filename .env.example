# Copy to .env and adjust. Nothing machine-specific is committed.

# --- storage ---------------------------------------------------------------
DATABASE_PATH=backend/ecoloop.db

# --- open-source LLM via Groq ----------------------------------------------
# Groq serves open-source models (Llama, Qwen, GPT-OSS, Kimi) with native tool
# calling. Get a key at https://console.groq.com/keys — it is read from the
# environment only and is never committed.
GROQ_API_KEY=
# Any tool-calling model in the Groq catalogue. llama-3.3-70b-versatile is the
# default; llama-3.1-8b-instant is cheaper and faster for a long horizon.
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
# Low by default: a control decision should be reproducible, not creative.
LLM_TEMPERATURE=0.2

# --- agent cadence and self-correction budget ------------------------------
# How often the supervisor re-plans, in simulation steps. 4 steps at a 900s
# timestep is hourly. Lower it for a livelier demo, raise it for long horizons.
DECISION_CADENCE_STEPS=4
MAX_TOOL_ITERATIONS=5
MAX_RETRIES=2
HISTORY_WINDOW_STEPS=96

# --- EnergyPlus (Milestone 4) ----------------------------------------------
# The installation directory, not a pip package. pyenergyplus lives inside it.
ENERGYPLUS_DIR=/Applications/EnergyPlus-25-1-0

# --- comfort limits, enforced by the guard ---------------------------------
COMFORT_PMV_LOW=-0.5
COMFORT_PMV_HIGH=0.5
MIN_ZONE_TEMP_C=19.0
MAX_ZONE_TEMP_C=26.0

# --- energy accounting -----------------------------------------------------
TARIFF_PER_KWH=0.18
GRID_CARBON_KG_PER_KWH=0.42
